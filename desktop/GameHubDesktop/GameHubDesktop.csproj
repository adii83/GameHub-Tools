<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Nama internal aplikasi -->
    <AssemblyName>GameHub</AssemblyName>
    <RootNamespace>GameHub</RootNamespace>

    <!-- Metadata untuk Windows Explorer -->
    <AssemblyTitle>GameHub</AssemblyTitle>
    <Product>GameHub</Product>
    <FileDescription>GameHub Desktop App</FileDescription>
    <Company>GameHub Tools</Company>

    <!-- VERSIONING — INI YANG PALING PENTING -->
    <AssemblyVersion>1.0.3.0</AssemblyVersion>
    <FileVersion>1.0.3.0</FileVersion>
    <Version>1.0.3</Version>

    <ApplicationIcon>Assets\gamehub.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2535.41" />
    <PackageReference Include="SharpCompress" Version="0.37.2" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\gamehub.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\public\**\*" Condition="Exists('..\\..\\public')">
      <Link>public\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\js\**\*" Condition="Exists('..\\..\\js')">
      <Link>js\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
